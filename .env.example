# Environment variables example for Life RPG (Lumi)

# SQLite database for zero-config local development
DATABASE_URL="file:./dev.db"

# For production deployment (e.g. Neon, Supabase, Vercel Postgres, Railway)
# DATABASE_URL="postgresql://user:password@host:5432/liferpg?sslmode=require"

# JWT Secret for authentication session cookies
JWT_SECRET="lumi-life-rpg-super-secret-key-change-in-production-12345"

# Environment
NODE_ENV="development"
