# ==============================================================================
# Life RPG with Lumi - Vercel Production & Local Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE_URL (Required)
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT:
DATABASE_URL="file:./dev.db"

# VERCEL / PRODUCTION DEPLOYMENT:
# Vercel is serverless with an ephemeral filesystem, so a cloud database is required.
# Recommended (Free tier available):
# - Neon:     postgresql://user:password@ep-cool-cloud.us-east-2.aws.neon.tech/neondb?sslmode=require
# - Supabase: postgresql://postgres:password@db.supabase.co:5432/postgres?sslmode=require
# - Vercel Postgres: automatically injected if added via Vercel Dashboard Storage tab
# DATABASE_URL="postgresql://user:password@host:5432/liferpg?sslmode=require"

# ------------------------------------------------------------------------------
# 2. JWT_SECRET (Required)
# ------------------------------------------------------------------------------
# A secure, random secret key used to sign session cookies for authentication.
# You can generate a random 32+ character string (e.g. openssl rand -base64 32).
JWT_SECRET="lumi-life-rpg-production-jwt-secret-replace-with-your-own-random-key"

# ------------------------------------------------------------------------------
# 3. NEXT_PUBLIC_APP_URL (Recommended for SEO & Canonical URLs)
# ------------------------------------------------------------------------------
# Your public production domain on Vercel. Used for OpenGraph, sitemap.xml, and robots.txt.
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# ------------------------------------------------------------------------------
# 4. NODE_ENV
# ------------------------------------------------------------------------------
NODE_ENV="production"
